# Example environment variables - replace with your own values
# Groq LLM key: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"
# Optional: any Groq model that supports tool calling
# GROQ_MODEL="openai/gpt-oss-120b"
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your_langsmith_api_key_here"
LANGSMITH_PROJECT="week02_langchain_agent_project"
# Weather/stock API keys live in the MCP server project's .env, not here.
# Optional: path to the MCP server project (default: ../weather-stock-mcp next to this project)
# MCP_SERVER_DIR="/path/to/weather-stock-mcp"
